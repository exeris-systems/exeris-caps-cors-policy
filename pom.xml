<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.caps</groupId>
    <artifactId>exeris-caps-cors-policy</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Exeris Caps :: CORS Policy</name>
    <description>
        Cross-origin request policy as a capability. Provides a pure decision
        function over request origin/method/headers; owns no transport and binds
        to no host runtime. Gateway caps consume it via @Requires.
    </description>
    <url>https://github.com/exeris-systems/exeris-caps-cors-policy</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <!-- community per ADR-023 — one of three caps that are Apache-2.0 rather than
         source-available commercial. Keep LICENSE in step with this. -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JDK 25 LTS, matching the ecosystem baseline (kernel ADR-066, SDK ADR-069,
             tooling U1). Deliberately no preview flag anywhere: a preview-stamped
             class re-pins this jar to one exact JDK major, which is the thing the
             preview-clean baseline exists to avoid. -->
        <maven.compiler.release>25</maven.compiler.release>

        <exeris.sdk.version>0.10.0</exeris.sdk.version>
        <!-- Released 2026-08-18 (tooling v0.7.0). Pinned to the release rather than a
             SNAPSHOT: tooling's main moved to 0.8.0-SNAPSHOT the moment the tag was cut, so
             a main-tracking build stopped producing the version this property asks for.
             Still built from source in CI — the published artefacts live on GitHub Packages
             and resolving them would reintroduce the credential this repo avoids by design. -->
        <exeris.tooling.version>0.7.0</exeris.tooling.version>

        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <dependencies>
        <!-- provided, not compile: every Exeris annotation is @Retention(SOURCE), so it
             is erased at javac and cannot be read at runtime. Taking it at compile scope
             would put a jar on consumers' runtime classpath that nothing can ever load
             from. The result is a cap jar with ZERO runtime dependencies. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
            <version>${exeris.sdk.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 + AssertJ only. This is the ADR-058 dependency contract for the
             generated-test channel, and holding hand-written tests to it too keeps the
             two indistinguishable to the build. No mocking framework: doubles are
             written (or emitted), never mocked. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- The processor is declared here rather than as a dependency so it
                         never reaches the compile classpath — it runs at javac time and
                         has no business being visible to this cap's own sources. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>eu.exeris.tooling</groupId>
                            <artifactId>exeris-processor</artifactId>
                            <version>${exeris.tooling.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-maven-plugin</artifactId>
                <version>${exeris.tooling.version}</version>
                <executions>
                    <!-- BOTH goals, and the pairing is load-bearing rather than tidy.

                         `generate` runs at generate-sources, where the capability
                         metadata on disk is by construction the PREVIOUS build's output
                         (the processor only refreshes it during compile). Historically a
                         graph failure there hard-failed, which deadlocked the build on
                         its own stale input: the @Requires edit that would fix the graph
                         could never take effect, because the build died on the file it
                         was about to replace.

                         GenerateMojo escapes that only when it can find a bound
                         `verify-capabilities` execution at process-classes or later. With
                         the pair below, a graph failure at generate-sources degrades to a
                         warning and the authoritative fail-closed verdict comes from the
                         post-compile gate, against metadata emitted THIS build. Drop the
                         second goal and the historical hard-fail returns, deadlock
                         included. -->
                    <execution>
                        <goals>
                            <goal>generate</goal>
                            <goal>verify-capabilities</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- Kernel and SDK artifacts are not on Maven Central yet (deliberate — the SDK
             does not move before the kernel does). CI installs both from source; this
             declaration is what a local build resolves against once you have run
             `mvn install` in the sibling checkouts. -->
        <repository>
            <id>github-exeris-kernel</id>
            <name>Exeris Kernel — GitHub Packages</name>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-kernel</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>
</project>
